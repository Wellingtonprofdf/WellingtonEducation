 <sequence>
  <item id="start" name="TROCA_WELLINGTON" />
 </sequence>
 <activities>
  <activity class="@puzzles.ExchangePuzzle" name="TROCA_WELLINGTON" code="">
   <description />
   <messages>
    <cell type="initial">
     <style shadow="true" borderStroke="0.7" markerStroke="5.0">
      <font family="Arial" size="36" bold="true" />
      <color foreground="0xFFFFFF" background="0x0099CC" />
     </style>
     <p>RESOLVA O QUEBRA-CABEÇAS EM ATÉ 60s</p>
    </cell>
    <cell type="final">
     <style>
      <font family="Arial" size="36" bold="true" />
      <color foreground="0xFFFFFF" background="0x009933" />
     </style>
     <p>PARABÉNS! VOCÊ CONSEGUIU!!!</p>
    </cell>
    <cell type="finalError">
     <style shadow="true">
      <font family="Arial" size="36" bold="true" />
      <color foreground="0xFFFFFF" background="0xFF0033" />
     </style>
     <p>TEMPO ESGOTADO! VAMOS TENTAR NOVAMENTE!</p>
    </cell>
   </messages>
   <settings margin="8" dragCells="true" maxTime="60" countDownTime="true" report="true" reportActions="false">
    <helpWindow showSolution="true" />
    <container bgColor="0xC0C0C0">
     <image name="mapaelfico.png" tiled="false" />
     <counters time="true" actions="false" score="false" />
    </container>
    <window bgColor="0xC0C0C0" transparent="true" border="true" />
    <skin file="@blue.xml" />
   </settings>
   <cells rows="2" cols="3" border="true" image="mago-resized.jpg">
    <style />
    <shaper class="@Rectangular" cols="3" rows="2" />
   </cells>
   <scramble times="31" />
  </activity>
