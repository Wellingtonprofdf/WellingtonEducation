<JClicProject name="quebra" version="0.1.3">
 <settings>
  <title>quebra</title>
  <revision description="created" date="11/14/26" />
  <descriptors />
  <meta_langs>pt-BR</meta_langs>
  <descriptions>
   <description language="pt-BR" />
  </descriptions>
  <license type="by-nc-sa" url="https://creativecommons.org/licenses/by-nc-sa/4.0" />
 </settings>
 <sequence>
  <item id="start" name="QUEBRADUPLO_WELLINGTON" />
 </sequence>
 <activities>
  <activity class="@puzzles.DoublePuzzle" name="QUEBRADUPLO_WELLINGTON" code="">
   <description />
   <messages>
    <cell type="initial">
     <style shadow="true" borderStroke="0.7" markerStroke="5.0">
      <font family="Arial" size="36" bold="true" />
      <color foreground="0xFFFFFF" background="0xCC66FF" />
     </style>
     <p>MONTE O QUEBRA CABEÇAS EM ATÉ 90s</p>
    </cell>
    <cell type="final">
     <style shadow="true">
      <font family="Arial" size="36" bold="true" />
      <color foreground="0xFFFFFF" background="0x00CC00" />
     </style>
     <p>PARABÉNS! VOCÊ DESCOBRIU A IMAGEM!</p>
    </cell>
    <cell type="finalError">
     <style shadow="true">
      <font family="Arial" size="36" bold="true" />
      <color foreground="0xFFFFFF" background="0xFF3333" />
     </style>
     <p>O TEMPO ACABOU, VAMOS TENTAR NOVAMENTE?</p>
    </cell>
   </messages>
   <settings margin="8" dragCells="true" maxTime="90" countDownTime="false" report="true" reportActions="false">
    <helpWindow showSolution="true" />
    <container bgColor="0xC0C0C0">
     <image name="planodefundo-resized1.jpg" tiled="true" />
     <counters time="true" actions="false" score="false" />
    </container>
    <window bgColor="0xC0C0C0" transparent="true" border="true" />
    <skin file="@blue.xml" />
   </settings>
   <cells rows="5" cols="5" border="true" image="ELFOSAMURAI-resized.jpg">
    <style borderStroke="3.0" markerStroke="2.7">
     <color inactive="0x99CCFF" border="0xFFFFFF" />
    </style>
    <shaper class="@ClassicJigSaw" cols="5" rows="5" />
   </cells>
   <scramble times="31" />
   <layout position="AB" />
  </activity>
 </activities>
 <mediaBag>
  <media name="ELFOSAMURAI-resized.jpg" file="elfosamurai-resized.jpg" />
  <media name="planodefundo-resized1.jpg" file="planodefundo-resized1.jpg" />
 </mediaBag>
