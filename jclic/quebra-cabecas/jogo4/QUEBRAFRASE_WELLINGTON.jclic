 <activities>
  <activity class="@puzzles.ExchangePuzzle" name="TROCAEXTRA_WELLINGTON" code="">
   <description />
   <messages>
    <cell type="initial">
     <style shadow="true" borderStroke="0.7" markerStroke="5.0">
      <font family="Arial" size="48" bold="true" />
      <color foreground="0xFFFFFF" background="0x0099CC" />
     </style>
     <p>ORGANIZE A FRASE EM ATÉ 30s</p>
    </cell>
    <cell type="final">
     <style shadow="true">
      <font family="Arial" size="48" bold="true" />
      <color foreground="0xFFFFFF" background="0x009900" />
     </style>
     <p>PARABÉNS! VOCÊ CONSEGUIU!!!</p>
    </cell>
    <cell type="finalError">
     <style shadow="true">
      <font family="Arial" size="48" bold="true" />
      <color foreground="0xFFFFFF" background="0xFF0000" />
     </style>
     <p>VAMOS TENTAR NOVAMENTE?</p>
    </cell>
   </messages>
   <settings margin="8" dragCells="true" maxTime="30" countDownTime="true" report="true" reportActions="false">
    <container bgColor="0xC0C0C0">
     <image name="kraken-resized.jpg" tiled="true" />
     <counters time="true" actions="false" score="false" />
    </container>
    <window bgColor="0xC0C0C0" transparent="true" border="true" />
    <skin file="@orange.xml" />
   </settings>
   <cells rows="1" cols="5" cellWidth="176.0" cellHeight="132.0" border="true">
    <style />
    <shaper class="@Rectangular" cols="5" rows="1" />
    <cell image="anossa-resized.jpg">
     <style shadow="true" transparent="true">
      <font family="Arial" size="48" bold="true" />
